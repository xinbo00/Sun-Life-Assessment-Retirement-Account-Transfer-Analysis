      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.19ewrkh1tpp5ff1epl4o61ambgtl].[sum:roll_amt:qk]&quot;' value='Rollover' />
          <alias key='&quot;[federated.19ewrkh1tpp5ff1epl4o61ambgtl].[sum:withdrawal_amount:qk]&quot;' value='Withdrawal ' />
        </aliases>
      </column>
      <column caption='Retention Rate' datatype='real' name='[Calculation_1211388697128960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([roll_amt]) / SUM([term_balance])' />
      </column>
      <column caption='Withdrawal asset share' datatype='real' name='[Calculation_1211388698738689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([withdrawal_amount]) / SUM([term_balance])' />
      </column>
      <column caption='Other asset gap' datatype='real' name='[Calculation_1211388709429250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-[Calculation_1211388698738689]- [Calculation_1211388697128960]' />
      </column>
      <column caption='Auto enrollment rate' datatype='real' name='[Calculation_1211388714610691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([auto])/COUNT([row_id])' />
      </column>
      <column caption='Rollover Rate' datatype='real' name='[Calculation_1211388736389124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_rollover_flag]) / COUNT([unique_id])' />
      </column>
      <column caption='Withdrawal rate' datatype='real' name='[Calculation_1211388737011718]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([withdrawal_flag]) / COUNT([unique_id])' />
      </column>
      <column caption='count row id' datatype='integer' name='[Calculation_1211388742045703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([row_id])' />
      </column>
      <column caption='Contact timing group' datatype='string' name='[Calculation_1211388761341963]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([days_to_first_contact]) THEN &quot;No Contact&quot;&#13;&#10;ELSEIF [days_to_first_contact] &lt; 0 THEN &quot;Data Issue&quot;&#13;&#10;ELSEIF [days_to_first_contact] &lt;= 1 THEN &quot;0-1 days&quot;&#13;&#10;ELSEIF [days_to_first_contact] &lt;= 3 THEN &quot;2-3 days&quot;&#13;&#10;ELSEIF [days_to_first_contact] &lt;= 7 THEN &quot;4-7 days&quot;&#13;&#10;ELSE &quot;8+ days&quot;&#13;&#10;END' />
      </column>
